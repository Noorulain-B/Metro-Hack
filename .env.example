# n8n AI Workflow Builder Environment Configuration

# Optional: OpenAI API Key for live AI generation (Recommended for Hackathon)
# OPENAI_API_KEY=sk-your_actual_openai_api_key_here
# Optional model override (defaults to gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional: Google Gemini API Key for live AI generation or multi-tier fallback
# GEMINI_API_KEY=your_gemini_api_key_here

# (If both keys are omitted, the application runs entirely in Local Mock Mode for $0 cost)
